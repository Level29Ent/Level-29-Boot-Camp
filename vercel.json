{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":null,
  "buildCommand":null,
  "outputDirectory":".",
  "headers":[
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}]},
    {"source":"/(.*).js","headers":[{"key":"Cache-Control","value":"public,max-age=0,must-revalidate"}]},
    {"source":"/(.*).html","headers":[{"key":"Cache-Control","value":"public,max-age=0,must-revalidate"}]},
    {"source":"/assets/(.*)","headers":[{"key":"Cache-Control","value":"public,max-age=86400"}]},
    {"source":"/vo/(.*)","headers":[{"key":"Cache-Control","value":"public,max-age=86400"}]}
  ]
}
